# =====================================================================
# ตัวแปรสภาพแวดล้อม (Environment Variables) สำหรับระบบลงเวลานักเรียน
# คัดลอกเป็น .env.local สำหรับรันเครื่อง / ตั้งค่าเดียวกันนี้บน Vercel
# =====================================================================

# --- Supabase (ฐานข้อมูล + auth) ---
# หาได้ที่ Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...    # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # service_role key (ความลับ — ห้ามเปิดเผย)

# --- Cloudinary (เก็บรูปใบหน้านักเรียน) ---
# หาได้ที่ Cloudinary Dashboard (Cloud name อยู่ด้านบน, API Key/Secret ใน Settings → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your_api_secret          # ความลับ

# --- Telegram (แจ้งเตือนเข้า–รับกลับบ้านเข้ากลุ่ม) ---
# BOT_TOKEN จาก @BotFather, CHAT_ID = id ของกลุ่ม/แชทที่ให้บอทส่งเข้า
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=-1001234567890

# --- (ไม่บังคับ) เวลาตัดสาย เช็คชื่อเข้าหลังเวลานี้ = สาย, ค่าเริ่มต้น 09:00 ---
# NEXT_PUBLIC_LATE_CUTOFF=08:30
